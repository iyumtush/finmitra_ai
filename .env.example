# ─── FinMitra Environment Configuration Template ───
# Copy this file to .env and fill in your credentials

# Supabase Configuration (PostgreSQL Database & Authentication)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Google Gemini API Key(s) (For Mitra AI Assistant & Multimodal Receipt OCR)
# Can be a single API key or comma-separated list for automatic key rotation
VITE_GEMINI_API_KEY="your-gemini-api-key"

# Optional: Grok API Key (xAI)
VITE_GROK_API_KEY="your-grok-api-key"
